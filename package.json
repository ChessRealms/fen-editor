{
  "name": "fen-editor",
  "version": "0.0.0",
  "packageManager": "npm@11.19.1",
  "engines": { "node": ">=24.15.0 <25", "npm": ">=11 <12" },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
